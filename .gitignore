# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# Python
.venv

# Direnv
.direnv

# Pre-commit
.pre-commit-config.yaml

# Coverage
coverage.xml

# Python
__pycache__
.pytest_cache
.sim-compose.gen.yml

# Training datasets generated from the simulator (ml/) — regenerable, and
# large enough that they belong in object storage rather than git.
ml/data/
*.npz
*.onnx

# Generated chart/output artifacts from sim/scenarios/*.py
sim/scenarios/output/

# Git worktrees
.worktree
.claude/worktrees

# nix
result
.nixos-test-history

# Target deployment
buildkitd.toml

# NDK
local.properties

# Wayfinder specifics
var/conf/wayfinder0.state
