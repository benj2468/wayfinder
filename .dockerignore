# Generated by Cargo
# will have compiled files and executables
#
# `**/` matters, not just `target`: the crates outside the root workspace
# (bins/wayfinder-nrf52840*, bins/wayfinder-stm32f411, libs/wayfinder-py, the
# libs/*/fuzz targets) each build into their own nested `target/`, and a bare
# `target` pattern matches only the root one — leaving ~9GB of local build
# output to be transferred as build context on every image build.
**/debug
**/target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# Python
.venv

# Direnv
.direnv

# Pre-commit
.pre-commit-config.yaml

# Coverage
coverage.xml
