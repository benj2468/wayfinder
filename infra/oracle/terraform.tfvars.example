# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored: it
# names your tenancy, not a secret, but it is per-operator rather than shared.

region           = "us-ashburn-1"
compartment_ocid = "ocid1.tenancy.oc1..REPLACE_ME"
ssh_public_key   = "ssh-ed25519 AAAA... you@example.org"

# Narrow this to your own address if it is stable. The management API port
# below is a different matter — see variables.tf.
# ssh_ingress_cidr = "203.0.113.4/32"

# Optional: a stable name for the CA, in Cloudflare.
# manage_dns         = true
# cloudflare_zone_id = "REPLACE_ME"
# dns_name           = "ca"

# Optional: the Cloudflare Tunnel that fronts the web dashboard.
# manage_tunnel         = true
# cloudflare_account_id = "REPLACE_ME"
# dashboard_name        = "dash"

# Optional: the Cloudflare Pages project behind the wayfndr.dev landing page.
# The page is uploaded by `scripts/wayfinder-ca.sh site`; this only creates the
# project and its custom domains, so that upload has somewhere to land.
# If the project already exists, import it rather than applying — see README.md.
# manage_site           = true
# cloudflare_account_id = "REPLACE_ME"
# site_project_name     = "wayfinder-site"
