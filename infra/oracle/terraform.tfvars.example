# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored: it
# names your tenancy, not a secret, but it is per-operator rather than shared.

region           = "us-ashburn-1"
compartment_ocid = "ocid1.tenancy.oc1..REPLACE_ME"
ssh_public_key   = "ssh-ed25519 AAAA... you@example.org"

# Narrow this to your own address if it is stable. The management API port
# below is a different matter — see variables.tf.
# ssh_ingress_cidr = "203.0.113.4/32"

# Optional: a stable name for the CA, in Cloudflare.
# manage_dns         = true
# cloudflare_zone_id = "REPLACE_ME"
# dns_name           = "ca"
